{
  "env": {
    "browser": true,
    "es6": true
  },
  "globals": {
    "React": "readonly",
    "ReactDOM": "readonly",
    "GIF": "readonly",
    "HelpModal": "readonly",
    "PopGraphModal": "readonly",
    "StatsPanel": "readonly",
    "SparklineSVG": "readonly",
    "StatsChip": "readonly",
    "MobileSparkline": "readonly",
    "TransportControls": "readonly",
    "MobileTransportBar": "readonly",
    "CanvasArea": "readonly",
    "MobileMinimapArea": "readonly",
    "drawBoard": "readonly",
    "drawMinimap": "readonly",
    "drawMinimapMobile": "readonly",
    "drawRotationPreview": "readonly",
    "ViewControls": "readonly",
    "ZoomSlider": "readonly",
    "DisplaySettings": "readonly",
    "BoundaryControls": "readonly",
    "SpeedSlider": "readonly",
    "BoardSliders": "readonly",
    "ModeControls": "readonly",
    "ToolsContent": "readonly",
    "MobileContextPanel": "readonly",
    "RulesSection": "readonly",
    "ExportContent": "readonly",
    "RLESection": "readonly",
    "FloatPanel": "readonly",
    "FloatPanelDirect": "readonly",
    "PanelGroup": "readonly",
    "CompactBody": "readonly",
    "ObservatoryPanelUtils": "readonly",
    "CartographerLayout": "readonly",
    "CartographerMobile": "readonly",
    "ObservatoryLayout": "readonly",
    "ObservatoryMobile": "readonly",
    "BottomSheet": "readonly",
    "LayoutSwitcher": "readonly",
    "TabContentBuilder": "readonly"
  },
  "parserOptions": {
    "ecmaVersion": 2020,
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "plugins": ["react"],
  "settings": {
    "react": {
      "version": "19"
    }
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-undef": "error",
    "no-redeclare": "warn",
    "eqeqeq": ["warn", "smart"],
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-func": "error",
    "react/jsx-uses-react": "warn",
    "react/jsx-uses-vars": "warn"
  }
}
