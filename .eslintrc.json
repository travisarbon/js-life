{
  "env": {
    "browser": true,
    "es6": true
  },
  "globals": {
    "React": "readonly",
    "ReactDOM": "readonly",
    "GIF": "readonly",
    "HashLife": "readonly",
    "HashLifeEngine": "readonly",
    "SimEngine": "readonly",
    "SimRunner": "writable",
    "CanvasRenderer": "readonly",
    "parseKey": "readonly",
    "makeKey": "readonly",
    "CoordUtils": "readonly",
    "detectAndParsePattern": "readonly",
    "overlayAges": "readonly",
    "PATTERN_GROUPS": "readonly",
    "PATTERNS": "writable",
    "PATTERN_META": "readonly",
    "RULE_PRESETS": "readonly",
    "SPEED_DELAYS": "readonly",
    "THEMES": "readonly",
    "MAX_HL_COORD": "readonly",
    "HL_GC_THRESHOLD": "readonly",
    "MAX_AGE": "readonly",
    "MAX_CELL_IMPORT": "readonly",
    "MAX_UNDO_STACK": "readonly",
    "STABLE_COUNT_THRESHOLD": "readonly",
    "GPS_DISPLAY_DURATION": "readonly",
    "STATS_CHIP_REAPPEAR_DELAY": "readonly",
    "MAX_FLOOD_FILL": "readonly",
    "ANALYSIS_TIMEOUT": "readonly",
    "LONG_PRESS_DELAY": "readonly"
  },
  "parserOptions": {
    "ecmaVersion": 2020,
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "plugins": ["react"],
  "settings": {
    "react": {
      "version": "16"
    }
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-undef": "error",
    "no-redeclare": "warn",
    "eqeqeq": ["warn", "smart"],
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-func": "error",
    "react/jsx-uses-react": "warn",
    "react/jsx-uses-vars": "warn"
  }
}
