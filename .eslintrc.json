{
  "env": {
    "browser": true,
    "es6": true
  },
  "globals": {
    "React": "readonly",
    "ReactDOM": "readonly",
    "GIF": "readonly"
  },
  "parserOptions": {
    "ecmaVersion": 2020,
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "plugins": ["react"],
  "settings": {
    "react": {
      "version": "16"
    }
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-undef": "error",
    "no-redeclare": "warn",
    "eqeqeq": ["warn", "smart"],
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-func": "error",
    "react/jsx-uses-react": "warn",
    "react/jsx-uses-vars": "warn"
  }
}
